<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="Federal IT and software contract awards from USAspending.gov as MCP tools for Claude and other AI clients.">
    <title>FedContracts MCP</title>
    <link rel="icon" href="data:,">
    <style>
      :root {
        --paper: #f3f5f7;
        --surface: #ffffff;
        --ink: #16212e;
        --muted: #556171;
        --rule: #cbd3dc;
        --blue: #1d4f91;
        --blue-wash: #e6eef8;
        --ok: #23704a;
        --stale: #8f5400;
        --none: #646d79;
        --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #0f1720;
          --surface: #16212e;
          --ink: #e4e9ef;
          --muted: #9aa6b4;
          --rule: #2c3a4a;
          --blue: #8eb6ea;
          --blue-wash: #1a2b40;
          --ok: #6fcf97;
          --stale: #f0b35a;
          --none: #a3acb8;
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 1.0625rem/1.55 var(--sans);
      }
      main { max-width: 48rem; margin: 0 auto; padding: 3rem 1rem 4rem; }
      a { color: var(--blue); text-underline-offset: 0.15em; }
      :focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
      code, pre, kbd { font-family: var(--mono); font-size: 0.875em; }
      p { margin: 0 0 1rem; max-width: 40rem; }

      header { border-top: 4px double var(--ink); padding-top: 1.25rem; }
      h1 { font-size: 2.25rem; line-height: 1.1; letter-spacing: -0.015em; margin: 0 0 1rem; }
      .lede { font-size: 1.1875rem; color: var(--ink); }
      h2 {
        font-size: 1.25rem; letter-spacing: -0.005em; margin: 3rem 0 1rem;
        padding-bottom: 0.4rem; border-bottom: 1px solid var(--rule);
      }
      h3 { font-size: 1.0625rem; margin: 0 0 0.25rem; }

      /* The connection URL: the one thing a visitor needs. */
      .endpoint { margin: 2rem 0 0; }
      .endpoint label { display: block; font-size: 0.875rem; color: var(--muted); margin-bottom: 0.35rem; }
      .field {
        display: flex; align-items: stretch;
        border: 1px solid var(--ink); border-left: 6px solid var(--blue);
        background: var(--surface);
      }
      .field input {
        flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink);
        font: 600 clamp(1rem, 3.6vw, 1.5rem)/1.2 var(--mono); padding: 0.9rem 1rem;
      }
      .field button {
        border: 0; border-left: 1px solid var(--ink); background: var(--ink); color: var(--paper);
        font: 600 0.9375rem var(--sans); padding: 0 1.25rem; cursor: pointer;
      }
      .field button:hover { background: var(--blue); }
      .endpoint small { display: block; color: var(--muted); font-size: 0.875rem; margin-top: 0.5rem; }

      dl.clients { margin: 0; }
      dl.clients dt { font-weight: 600; margin-top: 1rem; }
      dl.clients dd { margin: 0.15rem 0 0; color: var(--muted); }
      pre {
        margin: 0.4rem 0 0; padding: 0.75rem 0.9rem; overflow-x: auto;
        background: var(--surface); border: 1px solid var(--rule); color: var(--ink); line-height: 1.45;
      }

      .tools { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem 2rem; }
      @media (min-width: 44rem) { .tools { grid-template-columns: 1fr 1fr; } }
      .tools code { color: var(--blue); }
      .tools p { margin: 0.35rem 0 0; font-size: 0.9375rem; color: var(--muted); }

      .prompts { list-style: none; padding: 0; margin: 0; }
      .prompts li {
        margin: 0 0 0.6rem; padding: 0.6rem 0.9rem; max-width: 40rem;
        background: var(--blue-wash); border-radius: 0 0.75rem 0.75rem 0.75rem;
      }

      .badge {
        display: inline-flex; align-items: center; gap: 0.5rem;
        font-weight: 600; padding: 0.25rem 0.75rem; border: 1.5px solid currentColor; border-radius: 999px;
      }
      .badge::before { content: ""; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: currentColor; }
      .badge[data-status="ok"] { color: var(--ok); }
      .badge[data-status="stale"] { color: var(--stale); }
      .badge[data-status="never_synced"] { color: var(--none); }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem 2rem; margin: 1.25rem 0; }
      .stats div { border-top: 1px solid var(--rule); padding-top: 0.5rem; }
      .stats dt { font-size: 0.875rem; color: var(--muted); }
      .stats dd { margin: 0.1rem 0 0; font-weight: 600; font-variant-numeric: tabular-nums; }
      .stats dd span { display: block; font-weight: 400; font-size: 0.875rem; color: var(--muted); }
      .table-wrap { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; font-variant-numeric: tabular-nums; }
      caption { text-align: left; font-weight: 600; padding-bottom: 0.5rem; }
      th, td { text-align: left; padding: 0.4rem 0.75rem 0.4rem 0; border-bottom: 1px solid var(--rule); white-space: nowrap; }
      th { font-weight: 600; color: var(--muted); }
      td.num, th.num { text-align: right; }
      .status-failed { color: var(--stale); }
      .muted { color: var(--muted); }

      ul.caveats { padding-left: 1.1rem; margin: 0; max-width: 40rem; }
      ul.caveats li { margin-bottom: 0.4rem; }
      footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule); font-size: 0.875rem; color: var(--muted); }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
